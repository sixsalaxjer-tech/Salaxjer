# Family Expense PWA — environment configuration
# Copy to .env.local and adjust. Never commit real secrets here (see spec section 18, Security and Privacy).
# Items marked TO_CONFIRM are open decisions from family-expense-pwa-offline-spec.md section 7.

# TO_CONFIRM: APP_NAME
VITE_APP_NAME="Family Expense PWA"

# TO_CONFIRM: สกุลเงินหลัก (default base currency, must be one of shared/constants/currency.ts SUPPORTED_CURRENCIES)
VITE_DEFAULT_CURRENCY=THB

# TO_CONFIRM: จำนวนสมาชิกสูงสุดต่อ Household
VITE_MAX_MEMBERS_PER_HOUSEHOLD=20

# TO_CONFIRM: ต้อง Sync ข้ามอุปกรณ์ใน Version แรกหรือไม่ — set to true once Supabase is configured below.
VITE_SYNC_ENABLED=false

# Supabase project — Project Settings -> API in the Supabase dashboard.
# VITE_SUPABASE_ANON_KEY is the public "anon" key, safe to ship in frontend code (it has no
# access beyond what Row Level Security in supabase/schema.sql grants). Never put the
# "service_role" key here or anywhere in client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Login is username + password only (see src/features/auth/syntheticEmail.ts) — this domain is
# only used to shape a valid-looking Supabase Auth identifier and never receives real mail.
# Requires "Confirm email" to be turned OFF in Supabase (Authentication -> Providers -> Email).
VITE_AUTH_USERNAME_DOMAIN=users.sixsalaxjer-tech.github.io

# TO_CONFIRM: ต้องเข้ารหัสฐานข้อมูล Local หรือไม่ (whole-database encryption is not implemented in Phase 1;
# per-backup password encryption is available in Settings > Backup regardless of this flag)
VITE_ENCRYPT_LOCAL_DB=false

# TO_CONFIRM: ขนาดไฟล์หลักฐานสูงสุด (MB) — reserved for Phase 2 attachments
VITE_MAX_ATTACHMENT_SIZE_MB=5

# Storage quota warning threshold (VAL-010), percent of estimated quota used
VITE_STORAGE_WARNING_THRESHOLD_PERCENT=80
